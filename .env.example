# Local: leave SITE_URL blank for next dev; production: https://your-domain.example
# On Vercel an unset URL uses VERCEL_PROJECT_PRODUCTION_URL automatically.
NEXT_PUBLIC_SITE_URL=
# local = bundled initial content; sanity = published CMS content.
CMS_PROVIDER=local
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_VERSION=2026-10-01
# Server-only. Required ONLY for a private dataset; never use NEXT_PUBLIC_ for tokens.
SANITY_API_READ_TOKEN=
# Local seed only. Do not add to Vercel or Docker runtime.
SANITY_API_WRITE_TOKEN=
# Optional Studio-specific overrides; normally leave blank.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=
# VERCEL_PROJECT_PRODUCTION_URL, VERCEL_URL, VERCEL_ENV are provided by Vercel.
# NODE_ENV, PORT, HOSTNAME are provided by the hosting runtime; don't repurpose them.
